%%{init: {'flowchart': {'curve': 'linear'}}}%%
graph TD;
    __start__([<p>__start__</p>]):::first
    classify(classify)
    technical(technical)
    pricing(pricing)
    general(general)
    __end__([<p>__end__</p>]):::last
    __start__ --> classify;
    classify -.-> technical;
    classify -.-> pricing;
    classify -.-> general;
    technical --> __end__;
    pricing --> __end__;
    general --> __end__;
    classDef default fill:#f2f0ff,line-height:1.2;
    classDef first fill-opacity:0;
    classDef last fill:#bfb6fc;
